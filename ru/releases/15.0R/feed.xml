4;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA512-FreeBSD-15.0-RELEASE-riscv-riscv64.asc&#34;&gt;SHA512&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA256-FreeBSD-15.0-RELEASE-riscv-riscv64.asc&#34;&gt;SHA256&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&lt;div class=&#34;sect1&#34;&gt;&#xA;&lt;h2 id=&#34;_virtual_machine_image_checksums&#34;&gt;Virtual Machine Image Checksums&lt;/h2&gt;&#xA;&lt;div class=&#34;sectionbody&#34;&gt;&#xA;&lt;table class=&#34;tableblock frame-all grid-all stretch tblbasic tblwide&#34;&gt;&#xA;&lt;colgroup&gt;&#xA;&lt;col style=&#34;width: 33.3333%;&#34;/&gt;&#xA;&lt;col style=&#34;width: 33.3333%;&#34;/&gt;&#xA;&lt;col style=&#34;width: 33.3334%;&#34;/&gt;&#xA;&lt;/colgroup&gt;&#xA;&lt;thead&gt;&#xA;&lt;tr&gt;&#xA;&lt;th class=&#34;tableblock halign-left valign-top&#34;&gt;Architecture&lt;/th&gt;&#xA;&lt;th class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;code&gt;SHA512&lt;/code&gt;&lt;/th&gt;&#xA;&lt;th class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;code&gt;SHA256&lt;/code&gt;&lt;/th&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/thead&gt;&#xA;&lt;tbody&gt;&#xA;&lt;tr&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;amd64 (x86_64)&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA512-FreeBSD-15.0-RELEASE-amd64-vm.asc&#34;&gt;SHA512&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA256-FreeBSD-15.0-RELEASE-amd64-vm.asc&#34;&gt;SHA256&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;aarch64&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA512-FreeBSD-15.0-RELEASE-arm64-aarch64-vm.asc&#34;&gt;SHA512&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA256-FreeBSD-15.0-RELEASE-arm64-aarch64-vm.asc&#34;&gt;SHA256&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;tr&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;riscv64&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA512-FreeBSD-15.0-RELEASE-riscv-riscv64-vm.asc&#34;&gt;SHA512&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;td class=&#34;tableblock halign-left valign-top&#34;&gt;&lt;p class=&#34;tableblock&#34;&gt;&lt;a href=&#34;../checksums/CHECKSUM.SHA256-FreeBSD-15.0-RELEASE-riscv-riscv64-vm.asc&#34;&gt;SHA256&lt;/a&gt;&lt;/p&gt;&lt;/td&gt;&#xA;&lt;/tr&gt;&#xA;&lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;/div&gt;</description>
